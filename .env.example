# Server .env example — copy values into the .env you created on SSH
# Hostnames must be the Postgres/Redis container names on app-network (not localhost)

IMAGE=registry.example.com/aco-product-filters:latest
PORT=3000

# Traefik host (no https://) — must match DNS A/CNAME to this server
DOMAIN=filters.yourdomain.com
# Must match Traefik on this server (see traefik command: certificatesresolvers.mytlschallenge)
TRAEFIK_CERT_RESOLVER=mytlschallenge
# Docker network Traefik container is attached to (inspect traefik if unsure)
TRAEFIK_NETWORK=traefik-public

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes,unauthenticated_read_product_listings,write_metaobject_definitions,write_metaobjects,write_products,write_publications,write_themes
# Same host as DOMAIN, with https://
SHOPIFY_APP_URL=https://filters-staging.yourdomain.com

# Replace "postgres" / "redis" with the real names from:
#   docker network inspect app-network
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/aco_product_filters?schema=public
# Used for Shopify auth sessions AND analytics cache (required on staging/prod)
REDIS_URL=redis://redis:6379

POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
